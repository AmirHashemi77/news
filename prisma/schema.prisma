// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       String @id @default(uuid()) @db.Uuid
  name     String @unique
  slug     String @unique
  imageUrl String

  news News[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsAgency {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  news News[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  subtitle    String
  content     String[]
  imageUrl    String?
  sourceUrl   String   @unique
  publishDate DateTime
  viewCount   Int      @default(0)

  newsAgencyId String     @db.Uuid
  newsAgency   NewsAgency @relation(fields: [newsAgencyId], references: [id])

  categories Category[]
  comments   Comment[]
  viewedBy   UserNewsView[]
  savedBy    UserSavedNews[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishDate])
  @@index([newsAgencyId])
}
model Comment {
  id          String @id @default(uuid()) @db.Uuid
  commentText String

  // News
  newsId String @db.Uuid
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  // Author
  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([newsId, createdAt])
  @@index([authorId])
}

model UserSavedNews {
  id        String   @id @default(uuid()) @db.Uuid

  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  newsId    String   @db.Uuid
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  savedAt   DateTime @default(now())

  @@unique([userId, newsId])
  @@index([userId, savedAt])
  @@index([newsId])
}

model UserNewsView {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  newsId String @db.Uuid
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@unique([userId, newsId])
  @@index([userId, viewedAt])
  @@index([newsId])
}
enum IngestionStatus {
  RUNNING
  SUCCESS
  PARTIAL_FAILED
  FAILED
}

model IngestionLog {
  id String @id @default(uuid()) @db.Uuid

  sourceName String
  status     IngestionStatus @default(RUNNING)

  totalFetched Int @default(0)
  createdCount Int @default(0)
  skippedCount Int @default(0)
  failedCount  Int @default(0)

  errorMessage String? @db.Text

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([sourceName, startedAt])
  @@index([status])
  @@index([startedAt])
}
enum Gender {
  MALE
  FEMALE
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid

  tokenHash String   @unique

  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  firstName    String
  lastName     String

  userName     String @unique
  phoneNumber  String @unique
  email        String @unique

  gender       Gender
  passwordHash String

  comments  Comment[]
  newsViews UserNewsView[]
  savedNews UserSavedNews[] 

  lastSignInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
}